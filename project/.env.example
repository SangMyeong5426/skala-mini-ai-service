# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# 이 저장소에서는 ../../../../_통합개념_실습/LANGSMITH/base-langsmith/.env를
# 복사해 써도 된다 (run.sh가 .env가 없으면 자동 복사).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 모드(run_openai.sh)에서만 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o

# LLM_BACKEND=ollama 일 때 qwen3의 생각(thinking) 출력 — false(기본) | true | default
# default는 옵션을 보내지 않는 원본 동작이다. 생각 토큰이 화면에 안 보이면서 답변이 수 분 걸릴 수 있다.
# OLLAMA_THINK=false

# 개선 스위치 — 지정하지 않으면 ollama 는 개선 쪽, fake·openai 는 원본 쪽이 기본 (README '개선 스위치')
# ROUTER=semantic              # semantic | llm       — 질문 분류 (항목 2)
# TARGET_RESOLVER=semantic     # semantic | legacy    — 대상 시스템 추정·되묻기 (항목 3)
# VALIDATOR=grounded           # grounded | format    — 검수 근거 검증 (항목 4)
# RUNBOOK_SELECTOR=semantic    # semantic | keyword   — runbook 선택 (항목 5)
# OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# ROUTER_MARGIN=0.029
# TARGET_MIN_SCORE=0.4
# TARGET_MARGIN=0.04
