#!/usr/bin/env bash
# 커밋 하나를 git worktree 로 따로 꺼내 그 코드를 잰다 — 작업 중인 파일과 섞이지 않는다.
#
#   scripts/measure-at <git-ref> <label> [steps]
#
#   scripts/measure-at base before write,e2e
#   OLLAMA_THINK=false scripts/measure-at feat/ollama-think step1
#   MEASURE_REPEAT=3 scripts/measure-at base before-r3 e2e     # 회귀 쿼리를 3번 반복(중앙값용)
#
# steps : 쉼표로 묶는다. 기본값 all = route,target,judge,write,runbook,e2e (과제 1)
#         rating = rate,rateb,rroute,rclarify,rjudge,rlaw,e2e (과제 2 — 회귀 쿼리 기본값도 tools/queries_rating.json)
#   route·target·judge·write·runbook  tools/eval_nodes.py — 서버 없이 노드·LLM 호출을 직접 부른다 (과제 1)
#   rate·rateb·rroute·rclarify·rjudge·rlaw·rbase  tools/eval_rating.py — 등급 점검 노드를 직접 부른다 (과제 2)
#   e2e                       tools/measure_queries.py --spawn — 회귀 쿼리마다 서버를 새로 띄운다
#                             (MEASURE_QUERIES 로 쿼리 파일을 바꾼다)
#
# 측정 도구와 평가 세트는 지금 작업 트리의 것을, 에이전트 코드는 <git-ref> 의 것을 쓴다 —
# Before 와 After 를 같은 입력·같은 채점으로 잰다. 결과는 이 저장소의 runs/ 에 쌓인다.
# 개선 스위치(OLLAMA_THINK 등)는 환경변수로 주면 그대로 넘어가고 결과 파일에 기록된다.
#
# ollama serve 가 떠 있어야 한다. 측정하는 동안 같은 ollama 로 다른 요청(웹 채팅 등)을 보내면
# 지연시간이 섞인다.
set -euo pipefail
cd "$(dirname "$0")/.."
repo="$PWD"
ref="${1:?사용법: scripts/measure-at <git-ref> <label> [steps]}"
label="${2:?label 이 필요합니다}"
steps="${3:-all}"
queries="${MEASURE_QUERIES:-tools/queries.json}"
[ "$steps" = all ] && steps="route,target,judge,write,runbook,e2e"
if [ "$steps" = rating ]; then
  steps="rate,rateb,rroute,rclarify,rjudge,rlaw,e2e"
  queries="${MEASURE_QUERIES:-tools/queries_rating.json}"
fi
py="$repo/project/.venv/bin/python"
port="${MEASURE_PORT:-8101}"
out_dir="${MEASURE_OUT:-$repo/runs}"
repeat="${MEASURE_REPEAT:-1}"
backend="${LLM_BACKEND:-ollama}"
export LLM_BACKEND="$backend"

[ -x "$py" ] || { echo "project/.venv 가 없습니다 — cd project && bash sh/setup_venv.sh" >&2; exit 1; }
if [ "$backend" = ollama ] && ! curl -s --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null; then
  echo "ollama serve 가 응답하지 않습니다" >&2; exit 1
fi
if lsof -ti:"$port" >/dev/null 2>&1; then
  echo "포트 $port 를 이미 쓰고 있습니다 (MEASURE_PORT 로 바꿀 수 있다)" >&2; exit 1
fi

wt="$(mktemp -d "${TMPDIR:-/tmp}/skala-measure-XXXXXX")"
git worktree add --detach --quiet "$wt" "$ref"
trap 'git worktree remove --force "$wt" >/dev/null 2>&1 || true' EXIT
echo "측정: $ref ($(git -C "$wt" rev-parse --short HEAD)) → label=$label steps=$steps backend=$backend repeat=$repeat"

IFS=',' read -ra list <<< "$steps"
for step in "${list[@]}"; do
  case "$step" in
    route|target|judge|write|runbook)
      "$py" -u tools/eval_nodes.py "$step" --label "$label" --backend "$backend" \
        --code-root "$wt" --out-dir "$out_dir" ;;
    rate|rateb|rroute|rclarify|rjudge|rbase|rlaw)
      "$py" -u tools/eval_rating.py "$step" --label "$label" --backend "$backend" \
        --code-root "$wt" --out-dir "$out_dir" ;;
    e2e)
      "$py" -u tools/measure_queries.py run --label "e2e_$label" --code-root "$wt" --spawn \
        --base-url "http://127.0.0.1:$port" --out-dir "$out_dir" --repeat "$repeat" --queries "$queries" ;;
    *) echo "알 수 없는 단계: $step" >&2; exit 1 ;;
  esac
done
